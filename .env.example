# Copy to .env.local and fill in. NEXT_PUBLIC_* values are baked in at build time,
# so rebuild after changing them. Never put a private key here: the browser wallet signs.

# The real coordinator from experiments/demo_stack.py. These are the defaults.
NEXT_PUBLIC_COORDINATOR_URL=http://127.0.0.1:8000
NEXT_PUBLIC_COORDINATOR_WS=ws://127.0.0.1:8000/ws/jobs/{job}
# live | replay  (viewers can switch on the Data source page)
NEXT_PUBLIC_EVENT_SOURCE=live

# Chain. 84532 = Base Sepolia, 31337 = local Anvil (shows the LOCAL CHAIN banner)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# Circle test USDC on Base Sepolia. On Anvil, use the MockUSDC address.
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Set to the independently confirmed escrow address. Empty disables funding and leaves the Verify identity check unverified.
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_DISPUTE_WINDOW_S=120

# Fallback L3: set to "synthetic" when the CPU synthetic workload replaces the GPU.
NEXT_PUBLIC_FALLBACK=
